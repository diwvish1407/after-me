# AfterMe backend: LOCAL DEVELOPMENT settings (copied to backend/.env by `make setup`).
# backend/.env is read only when AFTERME_APP_ENV is unset or "dev". It is git-ignored.
# Every value here is a dev-only placeholder. Staging/production get real values from the
# secret manager (docs/DEPLOYMENT.md §4) and refuse to start with insecure settings.

AFTERME_APP_ENV=dev
# DEBUG must stay false in staging/prod.
AFTERME_DEBUG=false
AFTERME_LOG_LEVEL=INFO
AFTERME_PUBLIC_BASE_URL=http://localhost:8000
AFTERME_API_BASE_URL=http://localhost:8000

# Roles and passwords created by scripts/dev_db_setup.sh (dev defaults, not secrets).
AFTERME_DATABASE_URL=postgresql+psycopg://afterme_api:afterme_api_dev@localhost:5432/afterme_dev
AFTERME_MIGRATION_DATABASE_URL=postgresql+psycopg://afterme_owner:afterme_owner_dev@localhost:5432/afterme_dev
# Connection pool (per process).
# AFTERME_DB_POOL_SIZE=10
# AFTERME_DB_MAX_OVERFLOW=5
# AFTERME_DB_STATEMENT_TIMEOUT_MS=15000
# AFTERME_API_LOCK_TIMEOUT_MS=5000

AFTERME_JWT_ISSUER=afterme-dev
AFTERME_JWT_AUDIENCE=afterme-app
AFTERME_ACCESS_TOKEN_TTL_SECONDS=900
AFTERME_SESSION_IDLE_DAYS=60
AFTERME_SESSION_ABSOLUTE_DAYS=365

# Emails are written to backend/.dev_mail/ (git-ignored); only the file path is logged.
AFTERME_EMAIL_PROVIDER=console
AFTERME_EMAIL_FROM=AfterMe <no-reply@afterme.invalid>

# Trusted reverse proxies in front of the app: 0 locally; staging/prod MUST set it explicitly
# (1 behind a single load balancer). See README "Configuration".
AFTERME_TRUSTED_PROXY_HOPS=0
AFTERME_MIN_CLIENT_VERSION=0.0.0
AFTERME_RATE_LIMIT_ENABLED=true

# Argon2id (OWASP minimum: time 2, memory 19456 KiB). Lower values only work with APP_ENV=test.
# AFTERME_ARGON2_TIME_COST=3
# AFTERME_ARGON2_MEMORY_COST_KIB=65536
# AFTERME_ARGON2_PARALLELISM=4

# Where the console email provider writes messages (default: backend/.dev_mail).
# AFTERME_DEV_MAIL_DIR=

# Secrets: `make setup` appends freshly generated values below this line, or run
#   uv run python scripts/generate_jwt_key.py --with-pepper >> .env
# AFTERME_JWT_SIGNING_KEYS='{"<kid>": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}'
# AFTERME_JWT_ACTIVE_KID=<kid>
# AFTERME_HMAC_PEPPER=<at least 32 random bytes>
# During pepper rotation the old value stays valid for reads:
# AFTERME_HMAC_PEPPER_PREVIOUS=<previous pepper>

# --- Escalation engine (Phase 5) ------------------------------------------------------------
# The worker process (`make worker`) connects as afterme_worker, the only role that can create
# incidents. Every engine parameter is AFTERME_<NAME>: see docs/ESCALATION_ENGINE.md §13.
AFTERME_WORKER_DATABASE_URL=postgresql+psycopg://afterme_worker:afterme_worker_dev@localhost:5432/afterme_dev
# Setting a probe token turns the ingestion Hold trigger on (POST /internal/probe). Leave unset
# in local development: with no external monitor the system would otherwise sit in Hold.
# AFTERME_PROBE_TOKEN=
# AFTERME_TICK_SECONDS=15
# AFTERME_SETTLE_DELAY_SECONDS=300
# A contact-facing stage found more than this late (the worker was down) is put back, not run;
# it moves to at least LATE_SHIFT_MINUTES from now and the person is warned again.
# AFTERME_LATE_TOLERANCE_SECONDS=300
# AFTERME_LATE_SHIFT_MINUTES=30
# The absolute floor of the anomaly Hold (the rest follows the number of people, ESCALATION_ENGINE §7.2).
# AFTERME_ANOMALY_FLOOR_PER_HOUR=25

# Envelope encryption of instructions (SECURITY §6.2). `local` keeps the key-encryption key in
# the environment: development and tests only, refused in staging and production. A key is
# base64url of exactly 32 random bytes:  python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode().rstrip('='))"
# (Unset: a fixed development key is used, so anything encrypted locally is disposable.)
# AFTERME_KMS_PROVIDER=local
# AFTERME_KMS_LOCAL_KEY=
# AFTERME_KMS_LOCAL_KEY_PREVIOUS=

# --- Account deletion and integration tests (Phase 7) ---------------------------------------
# The retention job (`make maintenance`) connects as afterme_maintenance in staging/prod. In
# development that role cannot log in, so the default is the owner URL.
# AFTERME_MAINTENANCE_DATABASE_URL=
# AFTERME_ACCOUNT_DELETION_DAYS=30
# Integration tests only (never in production): a movable clock and a mail reader. Set the same
# values for the API (`make run`) and the worker (`make worker`) so they share one test clock.
# AFTERME_TEST_SUPPORT_ENABLED=true
# AFTERME_TEST_SUPPORT_TOKEN=<at least 32 random bytes>

# --- Notifications (Phase 8) ----------------------------------------------------------------
# Development uses the console email provider (files in .dev_mail/) and logs pushes.
# Real providers (staging/prod; DEPLOYMENT §4 and §10 have the owner checklist):
# AFTERME_EMAIL_PROVIDER=resend            # resend | postmark | smtp
# AFTERME_EMAIL_API_KEY=
# AFTERME_EMAIL_FROM="AfterMe <alerts@mail.example.com>"
# AFTERME_EMAIL_WEBHOOK_SECRET=            # Resend whsec_..., or the Postmark webhook password
# AFTERME_EMAIL_FALLBACK_PROVIDER=postmark # a different provider (optional)
# AFTERME_EMAIL_FALLBACK_API_KEY=
# AFTERME_EMAIL_FALLBACK_WEBHOOK_SECRET=
# AFTERME_SMTP_HOST= / AFTERME_SMTP_PORT=587 / AFTERME_SMTP_USERNAME= / AFTERME_SMTP_PASSWORD=
# AFTERME_PUSH_PROVIDER=fcm                # log (default) | noop | fcm
# AFTERME_FCM_PROJECT_ID=afterme-dev
# AFTERME_FCM_CREDENTIALS_JSON=            # a service-account key; unset = metadata server
# Prove a configuration without touching an account:
#   make admin ARGS="email-test --to you@example.com"
#   make admin ARGS="push-test --token <fcm token>"
