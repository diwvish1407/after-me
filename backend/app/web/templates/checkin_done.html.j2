{% extends "base.html.j2" %}
{% block title %}Checked in · AfterMe{% endblock %}
{% block content %}
<h1>You're checked in</h1>
{% if resolved %}<p>The missed check-in was settled. Nobody was contacted.</p>{% endif %}
{% if next_due %}<p>Your next check-in is due <strong>{{ next_due }}</strong>.</p>{% endif %}
<form method="post" action="/a/logout">
<input type="hidden" name="csrf" value="{{ csrf }}">
<button type="submit" class="secondary">Sign out</button>
</form>
{% endblock %}
