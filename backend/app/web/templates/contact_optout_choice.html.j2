{% extends "base.html.j2" %}
{% block title %}Stop emails · AfterMe{% endblock %}
{% block content %}
<h1>Stop emails from AfterMe</h1>
<p>Choose what you'd like. Nothing happens until you press a button.</p>
<form method="post" action="/c/optout">
<input type="hidden" name="csrf" value="{{ csrf }}">
<input type="hidden" name="token" value="{{ token }}">
<button type="submit" name="scope" value="this_person">Stop emails from {{ inviter_name }}'s AfterMe</button>
</form>
<section class="separate">
<h2>Not just this sender</h2>
<p>We won't email you about AfterMe again, on behalf of anyone, and every invitation to this address is cancelled.</p>
<form method="post" action="/c/optout">
<input type="hidden" name="csrf" value="{{ csrf }}">
<input type="hidden" name="token" value="{{ token }}">
<button type="submit" name="scope" value="everyone" class="secondary">Never contact me about AfterMe again</button>
</form>
</section>
{% endblock %}
