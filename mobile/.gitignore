# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Generated code: regenerated by `dart run build_runner build --delete-conflicting-outputs`
# and `flutter gen-l10n` (CI does the same before analyze/test). Never committed.
*.g.dart
*.freezed.dart
/lib/l10n/gen/

# Release signing material (also covered by android/.gitignore and the root .gitignore).
key.properties
*.jks
*.keystore
*.p12
*.pfx
*.pepk

# Local config copies (e.g. config/dev.local.json for a physical device).
/config/*.local.json
