<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Permissions (SECURITY.md §11, PLAY_STORE.md §3). The allowlist is enforced by
         tool/check_manifest_permissions.dart on the merged prod manifest.
         INTERNET is declared in main because the Flutter template only adds it to
         debug/profile. USE_BIOMETRIC is for the app lock (BiometricPrompt, Phase 2) and
         POST_NOTIFICATIONS for check-in reminders (Android 13+, asked only after an
         explanation). There is deliberately NO READ_CONTACTS: contacts come from the
         system picker. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- androidx.biometric 1.1.0 (through local_auth) declares the legacy USE_FINGERPRINT
         without a limit. Android 8.0-8.1 (API 26-27, our minSdk) still needs it for the
         fingerprint prompt, so it is kept there and dropped from Android 9+. -->
    <uses-permission
        android:name="android.permission.USE_FINGERPRINT"
        android:maxSdkVersion="27"
        tools:node="replace" />

    <!-- The push stack (Phase 8) also declares VIBRATE (flutter_local_notifications). A
         notification channel vibrates on the app's behalf and needs no permission, so the
         declaration is removed here rather than allowlisted. The permissions that stay
         (WAKE_LOCK, ACCESS_NETWORK_STATE, the FCM receive permissions) are listed, each with
         its reason, in tool/check_manifest_permissions.dart. -->
    <uses-permission android:name="android.permission.VIBRATE" tools:node="remove" />

    <!-- Backups are disabled (ARCHITECTURE.md §5.4): secure storage is device-bound and
         must never be restored to another device. dataExtractionRules also excludes
         everything from device-to-device transfer, which allowBackup="false" alone does
         not cover on Android 12+. -->
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- The app has no deep links: an intent's data is never pushed to the router
                 (the engine's default is on). MainActivity.kt also refuses every other
                 route/engine extra an app could send to this exported activity; the merged
                 manifest is checked by tool/check_manifest_permissions.dart. -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Push (Phase 8). Firebase is started from Dart with options compiled in through
             the build's dart-define file (no google-services.json, no google-services plugin).
             FCM stays idle until the person is signed in and has allowed notifications: the
             app turns auto-init on then (FirebaseMessaging.setAutoInitEnabled) and off again,
             with the token deleted, when the person signs out. -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <!-- A push that names no channel lands in the calm one, never in an "unknown" one;
             the server's own pushes always name their channel. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="account" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_afterme" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Opening the terms and privacy pages in the browser (url_launcher). -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
