<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31) SplashScreen, dark: the dark `bg` colour and the mark in the
         dark theme's colours (values-night/colors.xml). The night qualifier outranks the
         version one, so without this file a dark phone would get values-night/styles.xml
         and no splash attributes at all. -->
    <style name="LaunchTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
    </style>
</resources>
